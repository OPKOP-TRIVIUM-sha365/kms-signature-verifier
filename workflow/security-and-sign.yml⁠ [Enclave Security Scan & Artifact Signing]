name: Enclave Security Scan & Artifact Signing

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

permissions:
  contents: read
  security-events: write
  actions: write

jobs:
  security-and-sign:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install CI Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install bandit pytest hypothesis cryptography

      # PRIORITET 1: Integracija sigurnosnih skenera (SAST)
      - name: Run Bandit Security Linter
        run: |
          bandit -r . -ll -ii -v -f txt

      # PRIORITET 1: Skeniranje Docker okruženja
      - name: Run Trivy Vulnerability Scanner
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: 'fs'
          scan-ref: '.'
          format: 'table'
          severity: 'CRITICAL,HIGH'

      - name: Import GPG Key for Artifact Signing
        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}
        uses: crazy-max/ghaction-import-gpg@v6
        with:
          gpg_private_key: ${{ secrets.GPG_PRIVATE_KEY }}
          passphrase: ${{ secrets.GPG_PASSPHRASE }}

      # PRIORITET 5: Artifact Signing (Potpisivanje Merkle sažetka)
      - name: Sign Production Merkle Summary
        if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}
        run: |
          if [ -f "merkle_root_summary.json" ]; then
            gpg --batch --yes --pinentry-mode loopback --passphrase "${{ secrets.GPG_PASSPHRASE }}" --armor --detach-sign --output merkle_root_summary.json.asc merkle_root_summary.json
            echo "[+] Korijen istine uspješno kriptografski potpisan."
          else
            echo "[-] Upozorenje: merkle_root_summary.json nije pronađen za potpisivanje."
          fi

      - name: Upload Secured Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: secure-enclave-package
          path: |
            merkle_root_summary.json
            merkle_root_summary.json.asc
